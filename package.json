{
  "name": "collator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Collator - a Sanity Context agent that answers 'are these the same string?' by running it",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "oracle": "python oracle/run.py",
    "evidence": "tsx src/oracle/buildEvidence.ts",
    "ask": "tsx src/agent/run.ts",
    "serve": "tsx src/server/index.ts",
    "seed": "tsx scripts/seed.ts",
    "studio": "cd studio && sanity dev",
    "studio:build": "cd studio && sanity build ../dist -y",
    "baseline": "tsx src/oracle/baselineDemo.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanity": "^6.17.0",
    "styled-components": "^6.5.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "dotenv": "^18.0.5"
  }
}
