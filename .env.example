# ---------------------------------------------------------------------------
# Model provider - ANY OpenAI-compatible endpoint works. Nothing else is needed.
# Examples:
#   OPENAI:      LLM_BASE_URL=https://api.openai.com/v1        LLM_MODEL=gpt-4o-mini
#   OPENROUTER:  LLM_BASE_URL=https://openrouter.ai/api/v1     LLM_MODEL=openai/gpt-4o-mini
#   GROQ:        LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.3-70b-versatile
#   DEEPSEEK:    LLM_BASE_URL=https://api.deepseek.com/v1      LLM_MODEL=deepseek-chat
#   GEMINI:      LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai LLM_MODEL=gemini-2.0-flash
#   OLLAMA:      LLM_BASE_URL=http://127.0.0.1:1144/v1         LLM_MODEL=qwen2.5:14b
# ---------------------------------------------------------------------------
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_STEPS=8

# ---------------------------------------------------------------------------
# Sanity Context (Path One). See docs/SANITY_SETUP.md
# ---------------------------------------------------------------------------

# Organization API token with Context Viewer permission.
# Manage > API > Tokens (ORGANIZATION level) - keep server-side.
# (Distinct from SANITY_API_TOKEN below: this one reads Context, that one writes the dataset.)
SANITY_ORGANIZATION_TOKEN=

# e.g. "abc123xy" - from manage.sanity.io/projects
SANITY_PROJECT_ID=

# usually "production"
SANITY_DATASET=

# Context MCP endpoint names created in the Context app (Dashboard > Context).
# kbEndpoint  -> sources: Knowledge Base only   (mode: knowledge_base)
# groqEndpoint -> sources: dataset only          (mode: groq)
SANITY_MCP_ORG_ID=
SANITY_MCP_KB_ENDPOINT=
SANITY_MCP_GROQ_ENDPOINT=

# Project-level token with Editor permission, used ONLY by `npm run seed`.
# Project > API > Tokens > Create token (Editor role). Server-side only.
SANITY_API_TOKEN=

# Public dataset URL required by the submission template (optional until then)
SANITY_PUBLIC_DATASET_URL=

# Used only by `npm run studio` (Sanity Studio reads SANITY_STUDIO_* itself)
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

PORT=4173
